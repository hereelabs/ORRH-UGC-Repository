					<ProtectedString name="Source">-- makes the hat color accurate to the body part it&apos;s attached to
wait(1)

function sync()
local searchpart = &quot;Torso&quot; -- set to your bodypart (no spaces)
local character = script.Parent.Parent.Parent
bodycolors = character[&apos;Body Colors&apos;]

if character:FindFirstChild(searchpart) then
&#9;if bodycolors then
&#9;script.Parent.BrickColor = BrickColor.new(bodycolors[searchpart .. &quot;Color&quot;].Color)
&#9;end
end
end

sync()

script.Parent.Parent.Parent.Changed:connect(sync())</ProtectedString>
